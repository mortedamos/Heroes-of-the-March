{
  "name": "heroes-of-the-march-web",
  "version": "0.1.0",
  "private": true,
  "description": "Heroes of the March: three.js tabletop client with an authoritative rules engine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev",
    "sfx": "node scripts/sfx.ts",
    "skies": "node scripts/skies.ts",
    "numbers": "node scripts/card-numbers.ts",
    "rules-doc": "node scripts/rules-doc.ts",
    "export:cards": "node scripts/export-cards.ts",
    "ambience": "node scripts/sfx.ts",
    "balance:build": "rolldown scripts/balance/cli.ts --format esm --platform node --file _build/balance/cli.mjs && rolldown scripts/balance/report.ts --format esm --platform node --file _build/balance/report.mjs",
    "models": "node scripts/models.ts"
  },
  "dependencies": {
    "@fontsource/cinzel-decorative": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "exceljs": "^4.4.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
